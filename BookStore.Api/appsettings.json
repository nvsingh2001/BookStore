{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "BookStoreAPI",
    "Audience": "BookStoreClient",
    "PrivateKey": "jwt-private.pem",
    "PublicKey": "jwt-public.pem",
    "ExpirationHours": 60
  }
}
